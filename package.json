{
  "name": "3d-neighborhood-map",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build": "pnpm build:packages && pnpm --filter api build && pnpm --filter web build",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "import:osm": "python3 services/map-importer/src/main.py",
    "assets:build": "node assets/scripts/build-assets.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
