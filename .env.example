# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/neighborhood_map

# --- API ---
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# Admin credentials used by POST /api/v1/auth/login (MVP single-admin auth)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string
# Public base URL for models / images. Point at an S3/CDN bucket in production.
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/static
STORAGE_LOCAL_DIR=./storage
# Command used by the API to spawn the OSM importer process
IMPORTER_PYTHON=python3

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
